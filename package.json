{
  "name": "prompt-hub",
  "version": "0.1.2",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.15.0"
  },
  "scripts": {
    "dev": "pnpm --filter @prompt-hub/desktop dev",
    "build": "pnpm --filter @prompt-hub/desktop build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.55.0",
    "eslint": "9.39.2",
    "globals": "16.3.0",
    "typescript-eslint": "8.64.0"
  }
}
